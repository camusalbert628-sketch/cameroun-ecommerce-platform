generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  passwordHash  String
  phone         String?
  role          String         @default("CLIENT") // CLIENT, VENDOR, LOGISTICS, ADMIN, EXECUTIVE
  title         String?        // Ex: Directeur Général, Dir. Commercial, etc.
  city          String         @default("Douala")
  quarter       String?
  loyaltyPoints Int            @default(0)
  createdAt     DateTime       @default(now())
  vendorProfile VendorProfile?
  orders        Order[]
  claims        Claim[]
}

model VendorProfile {
  id             String    @id @default(cuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName    String
  rccm           String?
  niu            String?
  city           String    @default("Douala")
  status         String    @default("APPROVED") // PENDING, APPROVED, SUSPENDED
  commissionRate Float     @default(0.12)
  verifiedBadge  Boolean   @default(true)
  balanceFcfa    Int       @default(0)
  createdAt      DateTime  @default(now())
  products       Product[]
}

model Category {
  id               String    @id @default(cuid())
  name             String
  slug             String    @unique
  description      String
  icon             String
  isPriorityLaunch Boolean   @default(false)
  sortOrder        Int       @default(0)
  products         Product[]
}

model Product {
  id                  String         @id @default(cuid())
  title               String
  slug                String         @unique
  description         String
  sku                 String         @unique
  priceFcfa           Int
  costPriceFcfa       Int
  compareAtFcfa       Int?
  initialStock        Int            @default(0)
  stock               Int            @default(0)
  salesModel          String         @default("DIRECT_RETAIL") // DIRECT_RETAIL, MARKETPLACE_PARTNER, ON_ORDER
  qualityStatus       String         @default("APPROVED") // PENDING_QC, APPROVED, REJECTED
  warrantyMonths      Int            @default(12)
  leadTimeDaysDouala  Int            @default(1)
  leadTimeDaysYaounde Int            @default(2)
  leadTimeDaysOther   Int            @default(4)
  imageUrl            String
  specsJson           String         @default("{}")
  rating              Float          @default(4.7)
  reviewCount         Int            @default(0)
  isFeatured          Boolean        @default(false)
  isSponsored         Boolean        @default(false)
  categoryId          String
  category            Category       @relation(fields: [categoryId], references: [id])
  vendorId            String?
  vendor              VendorProfile? @relation(fields: [vendorId], references: [id])
  createdAt           DateTime       @default(now())
  orderItems          OrderItem[]
  reviews             Review[]
  variants            ProductVariant[]
}

model ProductVariant {
  id              String  @id @default(cuid())
  productId       String
  product         Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  label           String  // Ex: "256 Go · Bleu Nuit", "Taille L"
  sku             String  @unique
  usesCustomPrice Boolean @default(false)
  priceFcfa       Int
  initialStock    Int     @default(0)
  stock           Int     @default(0)
  colorHex        String?
}

model Order {
  id                  String       @id @default(cuid())
  orderNumber         String       @unique
  userId              String?
  user                User?        @relation(fields: [userId], references: [id])
  customerName        String
  customerPhone       String
  customerEmail       String?
  city                String
  quarter             String
  deliveryAddress     String
  deliveryMethod      String       // INTERNAL_DOUALA, PARTNER_COURIER, INTERCITY_TRANSPORT, RELAY_POINT, STORE_PICKUP
  paymentMethod       String       // ORANGE_MONEY, MTN_MOMO, CARD_VISA_MC, CASH_ON_DELIVERY
  paymentStatus       String       @default("PENDING") // PENDING, PAID, FAILED, REFUNDED
  paymentReference    String?
  status              String       @default("PENDING_PAYMENT")
  subtotalFcfa        Int
  deliveryFeeFcfa     Int
  discountFcfa        Int          @default(0)
  totalFcfa           Int
  commissionTotalFcfa Int          @default(0)
  assignedCourier     String?
  qcCheckedBy         String?
  trackingNotes       String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  items               OrderItem[]
  events              OrderEvent[]
  claims              Claim[]
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String
  product        Product @relation(fields: [productId], references: [id])
  vendorId       String?
  variantId      String?
  variantLabel   String?
  quantity       Int
  unitPriceFcfa  Int
  costPriceFcfa  Int
  commissionFcfa Int     @default(0)
}

model OrderEvent {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  stepCode    String
  label       String
  description String
  actorName   String
  createdAt   DateTime @default(now())
}

model Claim {
  id               String   @id @default(cuid())
  ticketNumber     String   @unique
  orderId          String
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId           String?
  user             User?    @relation(fields: [userId], references: [id])
  type             String   // RETURN, REFUND, QUALITY_ISSUE, DELIVERY_DELAY, WARRANTY
  status           String   @default("OPEN") // OPEN, IN_REVIEW, APPROVED, RESOLVED, REJECTED
  reason           String
  resolutionNote   String?
  refundAmountFcfa Int      @default(0)
  createdAt        DateTime @default(now())
}

model Review {
  id               String   @id @default(cuid())
  productId        String
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  authorName       String
  city             String
  rating           Int
  comment          String
  verifiedPurchase Boolean  @default(true)
  createdAt        DateTime @default(now())
}

model DeliveryZone {
  id             String  @id @default(cuid())
  city           String
  zoneName       String
  feeFcfa        Int
  estimatedDays  String
  supportsCod    Boolean @default(true)
  codMaxFcfa     Int     @default(150000)
  relayPointName String?
}

